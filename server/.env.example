PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-url> with your Atlas values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/simpldsc?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=simpldsc_super_secure_jwt_secret_key_2026_dev_prod
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=10

# Payment Gateway (Razorpay - set to sandbox keys or use dev simulation)
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_simpldsc_dummy_key
RAZORPAY_KEY_SECRET=rzp_secret_simpldsc_dummy_secret
RAZORPAY_WEBHOOK_SECRET=simpldsc_webhook_secret

# Official WhatsApp API Configuration
WHATSAPP_PROVIDER=MOCK
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=mock_whatsapp_bearer_token_simpl_dsc
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id

# Certifying Authority (CA) API Configuration (eMudhra/Capricorn/Vsign/Mock)
CA_PROVIDER=MOCK
CA_API_URL=https://api.mockca-india.gov.in/v1
CA_API_KEY=mock_ca_api_key_simpl_dsc_sandbox

# Email / SMTP Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=mock_user
EMAIL_PASSWORD=mock_password
EMAIL_FROM="SIMPLDSC Support <support@simpldsc.in>"

# 2Factor SMS OTP
# Use MOCK for local testing, or 2FACTOR to send real SMS messages.
OTP_PROVIDER=MOCK
TWOFACTOR_API_KEY=TWOFACTOR_API_KEY=755369fe-b3e4-11f1-af74-0200cd936042

